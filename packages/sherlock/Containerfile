FROM alpine 

RUN apk add --no-cache fish python3 git vim
RUN /usr/bin/fish -c "set -U fish_greeting"
WORKDIR /root
RUN git clone https://github.com/sherlock-project/sherlock
RUN apk del git
WORKDIR /root/sherlock
RUN python3 -m venv venv && ./venv/bin/pip install .
RUN echo "source /root/sherlock/venv/bin/activate.fish" > /root/.config/fish/config.fish
CMD ["fish"]
