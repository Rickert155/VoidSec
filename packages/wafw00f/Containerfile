FROM alpine 

RUN apk add --no-cache fish python3 git vim
RUN /usr/bin/fish -c "set -U fish_greeting"
WORKDIR /root
RUN git clone https://github.com/EnableSecurity/wafw00f
RUN apk del git
WORKDIR /root/wafw00f
RUN python3 -m venv venv && ./venv/bin/pip install .
RUN echo "source /root/wafw00f/venv/bin/activate.fish" > /root/.config/fish/config.fish
WORKDIR /tmp
CMD ["fish"]
