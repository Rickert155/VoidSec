FROM ubuntu:24.04

RUN apt update && apt install fish gcc make git libssl-dev libssh-dev \
		libidn11-dev libpcre3-dev \
                libgtk-3-dev libmysqlclient-dev libpq-dev libsvn-dev \
                firebird-dev libmemcached-dev libgpg-error-dev \
                freetds-dev -y
RUN /usr/bin/fish -c "set -U fish_greeting"
WORKDIR /root
RUN git clone https://github.com/vanhauser-thc/thc-hydra hydra
WORKDIR /root/hydra
RUN ./configure --prefix=/usr
RUN make
RUN make install
WORKDIR /root
RUN apt remove gcc make git -y && apt autoremove -y
CMD ["fish"]
