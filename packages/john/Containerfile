FROM ubuntu:24.04

RUN apt update && apt install libgomp1 fish gcc make git python3 python3-venv perl openssl libssl-dev -y
RUN /usr/bin/fish -c "set -U fish_greeting"
WORKDIR /root
RUN git clone https://github.com/openwall/john
WORKDIR /root/john/src
RUN ./configure && make
WORKDIR /root/john
RUN apt remove gcc make git -y && apt autoremove -y
CMD ["fish"]
