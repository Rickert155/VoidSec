FROM alpine 

RUN apk add --no-cache fish python3 git vim
RUN /usr/bin/fish -c "set -U fish_greeting"
WORKDIR /root
RUN git clone https://github.com/thewhiteh4t/FinalRecon finalrecon 
RUN apk del git
WORKDIR /root/finalrecon
RUN python3 -m venv venv && ./venv/bin/pip install -r requirements.txt
RUN echo "source /root/finalrecon/venv/bin/activate.fish" > /root/.config/fish/config.fish
CMD ["fish"]
