FROM alpine 

RUN apk add --no-cache fish python3 git vim bash
RUN /usr/bin/fish -c "set -U fish_greeting"
WORKDIR /root
RUN git clone https://github.com/Ekultek/WhatWaf
RUN apk del git
WORKDIR /root/WhatWaf
RUN python3 -m venv venv 
RUN ./venv/bin/pip install -r requirements.txt 
RUN ./venv/bin/pip install setuptools pyyaml pysocks 
RUN echo "root" | ./venv/bin/python setup.py install 
RUN echo "source /root/WhatWaf/venv/bin/activate.fish" > /root/.config/fish/config.fish
CMD ["fish"]
