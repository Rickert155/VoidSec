FROM ubuntu:24.04

RUN apt update && apt install fish gcc make autoconf libpcap-dev git -y
RUN /usr/bin/fish -c "set -U fish_greeting"
WORKDIR /root
RUN git clone https://github.com/netdiscover-scanner/netdiscover
WORKDIR /root/netdiscover
RUN ./autogen.sh
RUN ./configure
RUN make
RUN make install
WORKDIR /root
RUN rm -rf /root/*
RUN apt remove gcc make autoconf git -y && apt autoremove -y
CMD ["fish"]
